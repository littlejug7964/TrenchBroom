MDA1
# test model description
basemodel models/test/res2.md2

profile {
  evaluate "true"
  skin {
    pass {
      map models/test/profile_a
      alphafunc ge128
    }
  }
  skin {
    pass {
      map models/test/profile_b.tga
      blendmode add
    }
    pass {
      map models/test/skin_a.tga
    }
  }
}

profile RED {
  skin {
    pass {
      map models/test/skin_a.tga
    }
  }
}

headtri 1 2 3

